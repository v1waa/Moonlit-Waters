<windows:DialogWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:windows="clr-namespace:Moonlit_Waters.Windows" x:Class="Moonlit_Waters.Windows.AppointmentWindow" Title="Добавить запись" Width="550" SizeToContent="Height" WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}" ResizeMode="NoResize">
  <Border xmlns:ns0="https://github.com/avaloniaui" Padding="30,12,30,24" Background="#F7F4EF" CornerRadius="18">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="FormTitle" Text="Добавить запись" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0,0,0" Style="{StaticResource MutedText}"/>
        <Button Grid.Column="1" Content="×" Padding="4" MinHeight="28" Click="CancelClick" Style="{StaticResource GhostButton}"/>
      </Grid>
      <TextBlock Text="ФИО клиента" Style="{StaticResource LabelText}"/>
      <TextBox x:Name="NameBox" MaxLength="150"/>
      <TextBlock Text="Контактный номер" Style="{StaticResource LabelText}"/>
      <TextBox x:Name="PhoneBox" MaxLength="24"/>
      <TextBlock Text="Процедура" Style="{StaticResource LabelText}"/>
      <ComboBox x:Name="ServiceBox" SelectionChanged="ServiceChanged"/>
      <StackPanel x:Name="MasterPanel">
        <TextBlock Text="ФИО мастера" Style="{StaticResource LabelText}"/>
        <ComboBox x:Name="MasterBox"/>
      </StackPanel>
      <TextBlock Text="Дата и время записи (МСК)" Style="{StaticResource LabelText}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DatePicker x:Name="DateBox" SelectedDateFormat="Short" HorizontalAlignment="Stretch"/>
        <TextBox Grid.Column="2" x:Name="TimeBox" HorizontalAlignment="Stretch" MaxLength="5" ToolTip="Время в формате ЧЧ:ММ, например 10:30"/>
      </Grid>
      <StackPanel x:Name="StatusPanel">
        <TextBlock Text="Статус" Style="{StaticResource LabelText}"/>
        <ComboBox x:Name="StatusBox"/>
      </StackPanel>
      <TextBlock x:Name="ErrorText" Margin="8,14,8,0" Style="{StaticResource ErrorText}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
        <Button x:Name="SaveButton" Content="Добавить" Width="166" Click="SaveClick" Style="{StaticResource AppButton}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</windows:DialogWindow>
