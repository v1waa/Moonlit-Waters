<windows:DialogWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:windows="clr-namespace:Moonlit_Waters.Windows" x:Class="Moonlit_Waters.Windows.ClientWindow" Title="Добавить клиента" Width="510" SizeToContent="Height" WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}" ResizeMode="NoResize">
  <Border xmlns:ns0="https://github.com/avaloniaui" Padding="30,12,30,24" Background="#F7F4EF" CornerRadius="18">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="FormTitle" Text="Добавить клиента" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0,0,0" Style="{StaticResource MutedText}"/>
        <Button Grid.Column="1" Content="×" Padding="4" MinHeight="28" Click="CancelClick" Style="{StaticResource GhostButton}"/>
      </Grid>
      <TextBlock Text="ФИО клиента" Style="{StaticResource LabelText}"/>
      <TextBox x:Name="NameBox" MaxLength="150"/>
      <TextBlock Text="Контактный номер" Style="{StaticResource LabelText}"/>
      <TextBox x:Name="PhoneBox" MaxLength="24"/>
      <TextBlock Text="Email" Style="{StaticResource LabelText}"/>
      <TextBox x:Name="EmailBox" MaxLength="120"/>
      <TextBlock x:Name="ErrorText" Margin="8,14,8,0" Style="{StaticResource ErrorText}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
        <Button x:Name="SaveButton" Content="Добавить" Width="166" Click="SaveClick" Style="{StaticResource AppButton}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</windows:DialogWindow>
