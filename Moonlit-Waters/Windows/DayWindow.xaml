<windows:SectionWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:windows="clr-namespace:Moonlit_Waters.Windows" x:Class="Moonlit_Waters.Windows.DayWindow" Title="Рабочий день — Moonlit Waters" Width="1440" Height="900" MinWidth="1200" MinHeight="720" WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
  <Grid xmlns:ns0="https://github.com/avaloniaui">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#0F171A" Padding="18,28,18,22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top">
            <Border Width="38" Height="38" Background="White" CornerRadius="19" Margin="0,0,12,0">
              <TextBlock Text="☾" FontSize="27" Foreground="#0F171A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Moonlit&#10;Waters" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <Button x:Name="DayNav" Content="Рабочий день" Tag="day" Style="{StaticResource ActiveNavButton}"/>
            <Button x:Name="ClientsNav" Content="Клиенты" Tag="clients" Style="{StaticResource NavButton}"/>
            <Button x:Name="PricesNav" Content="Прайс-лист" Tag="prices" Style="{StaticResource NavButton}"/>
            <Button x:Name="StaffNav" Content="Персонал" Tag="staff" Style="{StaticResource NavButton}"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="10,0,0,0">
            <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock x:Name="UserRoleText" Foreground="#BFC4C4" FontSize="11" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Пароль" FontSize="11" Padding="0" MinHeight="20" x:Name="PasswordButton" Margin="0,0,12,0" Style="{StaticResource NavButton}"/>
              <Button Content="Выйти" FontSize="11" Padding="0" MinHeight="20" x:Name="LogoutButton" Style="{StaticResource NavButton}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="40,42,40,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="Рабочий день" Margin="0,0,0,3" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="PageSubtitle" Text="Записи и основные действия" Style="{StaticResource MutedText}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
            <TextBlock x:Name="TopRoleText" HorizontalAlignment="Right" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <DatePicker x:Name="DayPicker" Width="146" SelectedDateFormat="Short" Margin="0,0,6,0"/>
              <Button Content="↻" FontSize="22" MinHeight="32" x:Name="RefreshButton" Style="{StaticResource GhostButton}" ToolTip="Обновить данные"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="PageError" Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
        <Grid Grid.Row="2">
          <Grid x:Name="DayPage">
            <Grid.RowDefinitions>
              <RowDefinition Height="88"/>
              <RowDefinition Height="20"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="260"/>
              </Grid.ColumnDefinitions>
              <Border Padding="18,16" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Записей за день" FontSize="11" Margin="0,0,0,12" Style="{StaticResource MutedText}"/>
                  <TextBlock x:Name="CountText" Text="—" FontSize="27" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Padding="18,16" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Свободных окон" FontSize="11" Margin="0,0,0,12" Style="{StaticResource MutedText}" ToolTip="Часовые интервалы без пересечений до конца рабочего дня"/>
                  <TextBlock x:Name="FreeText" Text="—" FontSize="27" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Padding="18,16" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Выручка" FontSize="11" Margin="0,0,0,12" Style="{StaticResource MutedText}"/>
                  <TextBlock x:Name="RevenueText" Text="—" FontSize="27" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>
            </Grid>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="230"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="Записи на день" VerticalAlignment="Center" Style="{StaticResource HeadingText}"/>
                  <Button Content="+ Новая запись" HorizontalAlignment="Right" Width="166" Click="NewAppointmentClick" Style="{StaticResource AppButton}"/>
                  <Grid Grid.Row="1" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70"/>
                      <ColumnDefinition Width="1.2*"/>
                      <ColumnDefinition Width="1.5*"/>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="132"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Время" FontSize="11" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="1" Text="Клиент" FontSize="11" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="2" Text="Услуга" FontSize="11" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="3" Text="Мастер" FontSize="11" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="4" Text="Статус" FontSize="11" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                  </Grid>
                  <ListBox x:Name="AppointmentList" Grid.Row="2" MouseDoubleClick="AppointmentDoubleTapped">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#E0DED6" BorderThickness="0,1,0,0" Padding="0,15">
                          <Grid MinHeight="26">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="70"/>
                              <ColumnDefinition Width="1.2*"/>
                              <ColumnDefinition Width="1.5*"/>
                              <ColumnDefinition Width="110"/>
                              <ColumnDefinition Width="132"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ClientName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding ServiceName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding ShortMasterName}" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" Padding="0" MinHeight="26" Click="EditAppointmentClick" Tag="{Binding}" Style="{StaticResource GhostButton}">
                              <Border Background="#F7F4EF" CornerRadius="7" Padding="8,5" Width="120">
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                              </Border>
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="NoAppointments" Grid.Row="2" Text="На этот день записей нет." HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedText}" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <Border Grid.Column="2" VerticalAlignment="Top" Padding="20,22" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Ближайшая запись" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                  <TextBlock x:Name="NextTime" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,12"/>
                  <TextBlock x:Name="NextClient" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                  <TextBlock x:Name="NextService" TextWrapping="Wrap" Margin="0,0,0,12" Style="{StaticResource MutedText}"/>
                  <TextBlock x:Name="NextMaster" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
    <Border x:Name="DialogShade" Background="#B0D9D9D9" Visibility="Collapsed"/>
  </Grid>
</windows:SectionWindow>
