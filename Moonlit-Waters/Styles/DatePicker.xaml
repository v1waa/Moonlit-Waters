<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <Style x:Key="DateText" TargetType="primitives:DatePickerTextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#152024" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="primitives:DatePickerTextBox">
          <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CalendarButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#6E7A80" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="6">
            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                    Data="M 3,4 L 15,4 Q 16,4 16,5 L 16,15 Q 16,16 15,16 L 3,16 Q 2,16 2,15 L 2,5 Q 2,4 3,4 M 2,8 L 16,8 M 6,1 L 6,6 M 12,1 L 12,6 M 5,11 L 7,11 M 10,11 L 12,11" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0E3D9" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E2D5C9" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SalonCalendar" TargetType="Calendar">
    <Setter Property="Language" Value="ru-RU" />
    <Setter Property="FirstDayOfWeek" Value="Monday" />
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="#152024" />
    <Setter Property="BorderBrush" Value="#DED8D1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CalendarItemStyle">
      <Setter.Value>
        <Style TargetType="primitives:CalendarItem">
          <Setter Property="Background" Value="White" />
          <Setter Property="BorderBrush" Value="#DED8D1" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DatePicker">
    <Setter Property="Language" Value="ru-RU" />
    <Setter Property="FirstDayOfWeek" Value="Monday" />
    <Setter Property="SelectedDateFormat" Value="Short" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinWidth" Value="160" />
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="#152024" />
    <Setter Property="BorderBrush" Value="#DED8D1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CalendarStyle" Value="{StaticResource SalonCalendar}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Grid x:Name="PART_Root" SnapsToDevicePixels="True">
            <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <Grid Margin="11,3,3,3">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                <primitives:DatePickerTextBox x:Name="PART_TextBox" Style="{StaticResource DateText}"
                                             Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                             VerticalAlignment="Center" Margin="0,0,5,0" />
                <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource CalendarButton}"
                        ToolTip="Выбрать дату" AutomationProperties.Name="Открыть календарь" />
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="#A89280" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
