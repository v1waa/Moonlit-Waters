<windows:SectionWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:windows="clr-namespace:MoonlitWaters.Windows" x:Class="MoonlitWaters.Windows.StaffWindow" Title="Персонал — Moonlit Waters" Width="1440" Height="900" MinWidth="1200" MinHeight="720" WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
  <Grid xmlns:ns0="https://github.com/avaloniaui">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#0F171A" Padding="18,28,18,22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top">
            <Border Width="38" Height="38" Background="White" CornerRadius="19" Margin="0,0,12,0">
              <TextBlock Text="☾" FontSize="27" Foreground="#0F171A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Moonlit&#10;Waters" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <Button x:Name="DayNav" Content="Рабочий день" Tag="day" Style="{StaticResource NavButton}"/>
            <Button x:Name="ClientsNav" Content="Клиенты" Tag="clients" Style="{StaticResource NavButton}"/>
            <Button x:Name="PricesNav" Content="Прайс-лист" Tag="prices" Style="{StaticResource NavButton}"/>
            <Button x:Name="StaffNav" Content="Персонал" Tag="staff" Style="{StaticResource ActiveNavButton}"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="10,0,0,0">
            <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock x:Name="UserRoleText" Foreground="#BFC4C4" FontSize="11" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Пароль" FontSize="11" Padding="0" MinHeight="20" x:Name="PasswordButton" Margin="0,0,12,0" Style="{StaticResource NavButton}"/>
              <Button Content="Выйти" FontSize="11" Padding="0" MinHeight="20" x:Name="LogoutButton" Style="{StaticResource NavButton}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="40,42,40,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="Персонал" Margin="0,0,0,3" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="PageSubtitle" Text="Мастера, специализация и расписание" Style="{StaticResource MutedText}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
            <TextBlock x:Name="TopRoleText" HorizontalAlignment="Right" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <DatePicker x:Name="DayPicker" Width="146" SelectedDateFormat="Short" Margin="0,0,6,0"/>
              <Button Content="↻" FontSize="22" MinHeight="32" x:Name="RefreshButton" Style="{StaticResource GhostButton}" ToolTip="Обновить данные"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="PageError" Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
        <Grid Grid.Row="2">
          <Grid x:Name="StaffPage">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <ScrollViewer>
              <ItemsControl x:Name="StaffList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Margin="0,10,20,18" Height="176" Click="EditMasterClick" Tag="{Binding}" Style="{StaticResource StaffButton}">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="72"/>
                          <RowDefinition Height="1"/>
                          <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Border Background="#F0E3D9" CornerRadius="27" Width="54" Height="54" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Initial}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="2" Margin="0,4,0,0">
                            <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <TextBlock Text="{Binding Specialization}" Style="{StaticResource MutedText}"/>
                          </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="#E0DED6"/>
                        <Grid Grid.Row="2" VerticalAlignment="Center">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding ScheduleText}"/>
                          <TextBlock Grid.Column="1" Text="{Binding CountText}" FontWeight="SemiBold"/>
                        </Grid>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Grid.Row="1" Content="+ Добавить мастера" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Click="AddMasterClick" Style="{StaticResource AppButton}"/>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
    <Border x:Name="DialogShade" Background="#B0D9D9D9" Visibility="Collapsed"/>
  </Grid>
</windows:SectionWindow>
