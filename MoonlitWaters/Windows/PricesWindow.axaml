<windows:SectionWindow xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:windows="clr-namespace:MoonlitWaters.Windows" x:Class="MoonlitWaters.Windows.PricesWindow" Title="Прайс-лист — Moonlit Waters" Width="1440" Height="900" MinWidth="1200" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid ColumnDefinitions="210,*">
      <Border Background="#0F171A" Padding="18,28,18,22">
        <Grid RowDefinitions="90,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="10,0,0,0" VerticalAlignment="Top">
            <Border Width="38" Height="38" Background="White" CornerRadius="19">
              <TextBlock Text="☾" FontSize="27" Foreground="#0F171A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Moonlit&#10;Waters" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <Button x:Name="DayNav" Classes="app nav" Content="Рабочий день" Tag="day"/>
            <Button x:Name="ClientsNav" Classes="app nav" Content="Клиенты" Tag="clients"/>
            <Button x:Name="PricesNav" Classes="app nav active" Content="Прайс-лист" Tag="prices"/>
            <Button x:Name="StaffNav" Classes="app nav" Content="Персонал" Tag="staff"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="10,0,0,0" Spacing="6">
            <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="UserRoleText" Foreground="#BFC4C4" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
              <Button Classes="app nav" Content="Пароль" FontSize="11" Padding="0" MinHeight="20" x:Name="PasswordButton"/>
              <Button Classes="app nav" Content="Выйти" FontSize="11" Padding="0" MinHeight="20" x:Name="LogoutButton"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="40,42,40,28">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
          <StackPanel Spacing="3">
            <TextBlock x:Name="PageTitle" Classes="title" Text="Прайс-лист"/>
            <TextBlock x:Name="PageSubtitle" Classes="muted" Text="Стоимость и длительность услуг"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="12" HorizontalAlignment="Right">
            <TextBlock x:Name="TopRoleText" HorizontalAlignment="Right"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <CalendarDatePicker x:Name="DayPicker" Width="146" SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy"/>
              <Button Classes="app ghost" Content="↻" FontSize="22" MinHeight="32" ToolTip.Tip="Обновить данные" x:Name="RefreshButton"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="PageError" Grid.Row="1" Classes="error" IsVisible="False" Margin="0,0,0,10"/>
        <Grid Grid.Row="2">
          <Grid x:Name="PricesPage" RowDefinitions="64,20,*">
            <Border Classes="card" Padding="20,12">
              <Grid ColumnDefinitions="*,20,170">
                <TextBox x:Name="ServiceSearch" Classes="search" Watermark="Поиск услуги" TextChanged="ServiceSearchChanged" Width="500" HorizontalAlignment="Left"/>
                <Button Grid.Column="2" Content="+ Новая услуга" Click="NewServiceClick" Classes="app"/>
              </Grid>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="240,20,*">
              <Border Classes="card" Padding="16,24">
                <StackPanel Spacing="18">
                  <TextBlock Text="Категории" Classes="heading" Margin="6,0,0,4"/>
                  <StackPanel x:Name="CategoryPanel" Spacing="12"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="card">
                <Grid RowDefinitions="44,34,*">
                  <TextBlock x:Name="CategoryTitle" Classes="heading"/>
                  <Grid Grid.Row="1" ColumnDefinitions="*,140,150,40">
                    <TextBlock Text="Услуга" Classes="muted" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="Время" Classes="muted" FontSize="11"/>
                    <TextBlock Grid.Column="2" Text="Цена" Classes="muted" FontSize="11"/>
                  </Grid>
                  <ListBox x:Name="ServiceList" Grid.Row="2" DoubleTapped="ServiceDoubleTapped">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#E0DED6" BorderThickness="0,1,0,0" Padding="0,14">
                          <Grid ColumnDefinitions="*,140,150,40">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding DurationText}" Classes="muted" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding PriceText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Classes="app ghost" Content="•••" MinHeight="28" Padding="4" Click="EditServiceClick" Tag="{Binding}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="NoServices" Grid.Row="2" Text="Услуги не найдены." Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="False"/>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
    <Border x:Name="DialogShade" Background="#B0D9D9D9" IsVisible="False"/>
  </Grid>
</windows:SectionWindow>
