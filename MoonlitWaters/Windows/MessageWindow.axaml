<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MoonlitWaters.Windows.MessageWindow" Title="Moonlit Waters" Width="480" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"><StackPanel Margin="28" Spacing="20"><TextBlock x:Name="Heading" Classes="heading" /><SelectableTextBlock x:Name="Message" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button x:Name="CopyButton" Classes="app ghost" Content="Копировать" Click="CopyClick" /><Button x:Name="CancelButton" Content="Отмена" Classes="app ghost" IsVisible="False" Click="CancelClick" /><Button Content="ОК" Width="100" Click="OkClick" Classes="app" /></StackPanel></StackPanel></Window>