<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MoonlitWaters.Windows.AppointmentWindow" Title="Добавить запись" Width="550" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner" SystemDecorations="BorderOnly">
  <Border Padding="30,12,30,24" Background="#F7F4EF" CornerRadius="18">
    <StackPanel>
      <Grid ColumnDefinitions="*,30"><TextBlock x:Name="FormTitle" Text="Добавить запись" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0,0,0" /><Button Grid.Column="1" Content="×" Classes="app ghost" Padding="4" MinHeight="28" Click="CancelClick" /></Grid>
      <TextBlock Text="ФИО клиента" Classes="label" /><TextBox x:Name="NameBox" MaxLength="150" />
<TextBlock Text="Контактный номер" Classes="label" /><TextBox x:Name="PhoneBox" MaxLength="24" />
<TextBlock Text="Процедура" Classes="label" /><ComboBox x:Name="ServiceBox" SelectionChanged="ServiceChanged" />
<StackPanel x:Name="MasterPanel"><TextBlock Text="ФИО мастера" Classes="label" /><ComboBox x:Name="MasterBox"  />
</StackPanel><TextBlock Text="Дата и время записи (МСК)" Classes="label" /><Grid ColumnDefinitions="*,12,*"><CalendarDatePicker x:Name="DateBox" SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy" HorizontalAlignment="Stretch" /><TimePicker Grid.Column="2" x:Name="TimeBox" ClockIdentifier="24HourClock" MinuteIncrement="5" HorizontalAlignment="Stretch" /></Grid><StackPanel x:Name="StatusPanel"><TextBlock Text="Статус" Classes="label" /><ComboBox x:Name="StatusBox"  />
</StackPanel>
      <TextBlock x:Name="ErrorText" Classes="error" Margin="8,14,8,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,18,0,0">
        <Button x:Name="SaveButton" Content="Добавить" Width="166" Click="SaveClick" Classes="app" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>