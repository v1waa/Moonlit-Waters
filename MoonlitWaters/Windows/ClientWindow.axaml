<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MoonlitWaters.Windows.ClientWindow" Title="Добавить клиента" Width="510" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner" SystemDecorations="BorderOnly">
  <Border Padding="30,12,30,24" Background="#F7F4EF" CornerRadius="18">
    <StackPanel>
      <Grid ColumnDefinitions="*,30"><TextBlock x:Name="FormTitle" Text="Добавить клиента" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0,0,0" /><Button Grid.Column="1" Content="×" Classes="app ghost" Padding="4" MinHeight="28" Click="CancelClick" /></Grid>
      <TextBlock Text="ФИО клиента" Classes="label" /><TextBox x:Name="NameBox" MaxLength="150" />
<TextBlock Text="Контактный номер" Classes="label" /><TextBox x:Name="PhoneBox" MaxLength="24" />
<TextBlock Text="Email" Classes="label" /><TextBox x:Name="EmailBox" MaxLength="120" />

      <TextBlock x:Name="ErrorText" Classes="error" Margin="8,14,8,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,18,0,0">
        <Button x:Name="SaveButton" Content="Добавить" Width="166" Click="SaveClick" Classes="app" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>