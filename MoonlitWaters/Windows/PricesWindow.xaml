<windows:SectionWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:windows="clr-namespace:MoonlitWaters.Windows" x:Class="MoonlitWaters.Windows.PricesWindow" Title="Прайс-лист — Moonlit Waters" Width="1440" Height="900" MinWidth="1200" MinHeight="720" WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
  <Grid xmlns:ns0="https://github.com/avaloniaui">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#0F171A" Padding="18,28,18,22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top">
            <Border Width="38" Height="38" Background="White" CornerRadius="19" Margin="0,0,12,0">
              <TextBlock Text="☾" FontSize="27" Foreground="#0F171A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Moonlit&#10;Waters" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <Button x:Name="DayNav" Content="Рабочий день" Tag="day" Style="{StaticResource NavButton}"/>
            <Button x:Name="ClientsNav" Content="Клиенты" Tag="clients" Style="{StaticResource NavButton}"/>
            <Button x:Name="PricesNav" Content="Прайс-лист" Tag="prices" Style="{StaticResource ActiveNavButton}"/>
            <Button x:Name="StaffNav" Content="Персонал" Tag="staff" Style="{StaticResource NavButton}"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="10,0,0,0">
            <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock x:Name="UserRoleText" Foreground="#BFC4C4" FontSize="11" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Пароль" FontSize="11" Padding="0" MinHeight="20" x:Name="PasswordButton" Margin="0,0,12,0" Style="{StaticResource NavButton}"/>
              <Button Content="Выйти" FontSize="11" Padding="0" MinHeight="20" x:Name="LogoutButton" Style="{StaticResource NavButton}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="40,42,40,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="Прайс-лист" Margin="0,0,0,3" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="PageSubtitle" Text="Стоимость и длительность услуг" Style="{StaticResource MutedText}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
            <TextBlock x:Name="TopRoleText" HorizontalAlignment="Right" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <DatePicker x:Name="DayPicker" Width="146" SelectedDateFormat="Short" Margin="0,0,6,0"/>
              <Button Content="↻" FontSize="22" MinHeight="32" x:Name="RefreshButton" Style="{StaticResource GhostButton}" ToolTip="Обновить данные"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="PageError" Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
        <Grid Grid.Row="2">
          <Grid x:Name="PricesPage">
            <Grid.RowDefinitions>
              <RowDefinition Height="64"/>
              <RowDefinition Height="20"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Padding="20,12" Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServiceSearch" TextChanged="ServiceSearchChanged" Width="500" HorizontalAlignment="Left" Style="{StaticResource SearchBox}" Tag="Поиск услуги"/>
                <Button Grid.Column="2" Content="+ Новая услуга" Click="NewServiceClick" Style="{StaticResource AppButton}"/>
              </Grid>
            </Border>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Padding="16,24" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Категории" Margin="6,0,0,22" Style="{StaticResource HeadingText}"/>
                  <StackPanel x:Name="CategoryPanel"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="CategoryTitle" Style="{StaticResource HeadingText}"/>
                  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="140"/>
                      <ColumnDefinition Width="150"/>
                      <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Услуга" FontSize="11" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="1" Text="Время" FontSize="11" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="2" Text="Цена" FontSize="11" Style="{StaticResource MutedText}"/>
                  </Grid>
                  <ListBox x:Name="ServiceList" Grid.Row="2" MouseDoubleClick="ServiceDoubleTapped">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#E0DED6" BorderThickness="0,1,0,0" Padding="0,14">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="140"/>
                              <ColumnDefinition Width="150"/>
                              <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding DurationText}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                            <TextBlock Grid.Column="2" Text="{Binding PriceText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="•••" MinHeight="28" Padding="4" Click="EditServiceClick" Tag="{Binding}" Style="{StaticResource GhostButton}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="NoServices" Grid.Row="2" Text="Услуги не найдены." VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource MutedText}" Visibility="Collapsed"/>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
    <Border x:Name="DialogShade" Background="#B0D9D9D9" Visibility="Collapsed"/>
  </Grid>
</windows:SectionWindow>
