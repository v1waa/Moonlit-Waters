<windows:SectionWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:windows="clr-namespace:MoonlitWaters.Windows" x:Class="MoonlitWaters.Windows.ClientsWindow" Title="Клиенты — Moonlit Waters" Width="1440" Height="900" MinWidth="1200" MinHeight="720" WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
  <Grid xmlns:ns0="https://github.com/avaloniaui">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#0F171A" Padding="18,28,18,22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top">
            <Border Width="38" Height="38" Background="White" CornerRadius="19" Margin="0,0,12,0">
              <TextBlock Text="☾" FontSize="27" Foreground="#0F171A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Moonlit&#10;Waters" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <Button x:Name="DayNav" Content="Рабочий день" Tag="day" Style="{StaticResource NavButton}"/>
            <Button x:Name="ClientsNav" Content="Клиенты" Tag="clients" Style="{StaticResource ActiveNavButton}"/>
            <Button x:Name="PricesNav" Content="Прайс-лист" Tag="prices" Style="{StaticResource NavButton}"/>
            <Button x:Name="StaffNav" Content="Персонал" Tag="staff" Style="{StaticResource NavButton}"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="10,0,0,0">
            <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock x:Name="UserRoleText" Foreground="#BFC4C4" FontSize="11" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Пароль" FontSize="11" Padding="0" MinHeight="20" x:Name="PasswordButton" Margin="0,0,12,0" Style="{StaticResource NavButton}"/>
              <Button Content="Выйти" FontSize="11" Padding="0" MinHeight="20" x:Name="LogoutButton" Style="{StaticResource NavButton}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="40,42,40,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="Клиенты" Margin="0,0,0,3" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="PageSubtitle" Text="Контакты и история посещений" Style="{StaticResource MutedText}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
            <TextBlock x:Name="TopRoleText" HorizontalAlignment="Right" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <DatePicker x:Name="DayPicker" Width="146" SelectedDateFormat="Short" Margin="0,0,6,0"/>
              <Button Content="↻" FontSize="22" MinHeight="32" x:Name="RefreshButton" Style="{StaticResource GhostButton}" ToolTip="Обновить данные"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="PageError" Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
        <Grid Grid.Row="2">
          <Grid x:Name="ClientsPage">
            <Grid.RowDefinitions>
              <RowDefinition Height="64"/>
              <RowDefinition Height="20"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Padding="20,12" Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ClientSearch" TextChanged="ClientSearchChanged" MaxWidth="580" HorizontalAlignment="Left" Width="500" Style="{StaticResource SearchBox}" Tag="Поиск по имени или телефону"/>
                <Button x:Name="AddClientButton" Grid.Column="2" Content="+ Новый клиент" Click="AddClientClick" Style="{StaticResource AppButton}"/>
              </Grid>
            </Border>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="290"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="Клиенты" Style="{StaticResource HeadingText}"/>
                  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.2*"/>
                      <ColumnDefinition Width="1.1*"/>
                      <ColumnDefinition Width="140"/>
                      <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Имя" FontSize="11" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="1" Text="Телефон" FontSize="11" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="2" Text="Последний визит" FontSize="11" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="3" Text="Визитов" FontSize="11" Style="{StaticResource MutedText}"/>
                  </Grid>
                  <ListBox Grid.Row="2" x:Name="ClientList" SelectionChanged="ClientSelected" MouseDoubleClick="ClientDoubleTapped">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#E0DED6" BorderThickness="0,1,0,0" Padding="0,23">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="1.2*"/>
                              <ColumnDefinition Width="1.1*"/>
                              <ColumnDefinition Width="140"/>
                              <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Phone}" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="{Binding LastVisitText}" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="{Binding Visits}" FontWeight="SemiBold"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="NoClients" Grid.Row="2" Text="Клиенты не найдены." VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource MutedText}" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="ClientNameText" Text="Выберите клиента" TextWrapping="Wrap" Margin="0,0,0,14" Style="{StaticResource HeadingText}"/>
                  <TextBlock x:Name="ClientPhoneText" Margin="0,0,0,14" Style="{StaticResource MutedText}"/>
                  <TextBlock x:Name="ClientEmailText" TextWrapping="Wrap" Margin="0,0,0,14" Style="{StaticResource MutedText}"/>
                  <Border Height="1" Background="#E0DED6" Margin="0,8,0,22"/>
                  <TextBlock Text="Последний визит" FontSize="11" Margin="0,0,0,14" Style="{StaticResource MutedText}"/>
                  <TextBlock x:Name="ClientLastService" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,14"/>
                  <TextBlock x:Name="ClientLastVisit" TextWrapping="Wrap" Margin="0,0,0,14" Style="{StaticResource MutedText}"/>
                  <Button x:Name="ClientBookingButton" Content="Новая запись" Margin="0,28,0,0" HorizontalAlignment="Stretch" IsEnabled="False" Click="ClientBookingClick" Style="{StaticResource AppButton}"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
    <Border x:Name="DialogShade" Background="#B0D9D9D9" Visibility="Collapsed"/>
  </Grid>
</windows:SectionWindow>
