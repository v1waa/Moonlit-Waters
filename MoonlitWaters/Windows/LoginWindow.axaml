<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MoonlitWaters.Windows.LoginWindow" Title="Moonlit Waters — Вход" Width="1100" Height="700" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterScreen">
  <Border Width="720" Padding="40,22,40,30" Background="#F0E3D9" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel>
      <TextBlock Text="Авторизация" FontSize="26" FontWeight="Light" HorizontalAlignment="Center" Margin="0,0,0,10" />
      <StackPanel Width="270">
        <TextBlock Text="Логин" Margin="6,8,0,3" />
        <TextBox x:Name="LoginBox" MaxLength="32" KeyDown="InputKeyDown" />
        <TextBlock Text="Пароль" Margin="6,10,0,3" />
        <TextBox x:Name="PasswordBox" PasswordChar="●" MaxLength="72" KeyDown="InputKeyDown" />
      </StackPanel>
      <TextBlock x:Name="ErrorText" Classes="error" TextAlignment="Center" MaxWidth="600" Margin="0,14,0,0" MinHeight="32" />
      <Button x:Name="LoginButton" Content="Войти" Width="145" HorizontalAlignment="Center" Margin="0,14,0,4" Click="LoginClick" Classes="app" />
    </StackPanel>
  </Border>
</Window>
